# The production value must use a registry digest, never a tag.
SUITE_IMAGE=registry.subcult.tv/productivity-suite/suite@sha256:REPLACE_WITH_64_HEX_DIGEST

# Optional bundled Baikal (ADR 0039, docs/operations/baikal-setup.md).
# Uncomment together with `docker compose --profile bundled-baikal`.
# BAIKAL_ENDPOINT=http://baikal-bundled/dav.php/
# TADOOER_BAIKAL_DATA_ROOT=/srv/apps/productivity/data/tadooer-baikal
# TADOOER_BAIKAL_ADMIN_PORT=18086

# Background calendar bridge worker (ADR 0043,
# docs/operations/tadooer-production.md). Runs only for enabled mappings.
# Pass these through the suite service environment to change the defaults.
# SUITE_CALENDAR_BRIDGE_WORKER=true
# SUITE_CALENDAR_BRIDGE_INTERVAL_SECONDS=300
# SUITE_CALENDAR_BRIDGE_PROJECTION_INTERVAL_SECONDS=900
