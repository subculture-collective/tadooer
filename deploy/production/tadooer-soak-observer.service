[Unit]
Description=Tadooer pinned-candidate soak evidence
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /srv/apps/productivity/operations/observe-soak.py /srv/apps/productivity/soak/active.json
TimeoutStartSec=180
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/apps/productivity/soak
PrivateTmp=true
