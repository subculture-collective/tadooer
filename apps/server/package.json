{
  "name": "@suite/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/main.ts src/cli.ts --bundle --platform=node --format=esm --out-extension:.js=.mjs --outdir=dist",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@suite/caldav": "workspace:*",
    "@suite/contracts": "workspace:*",
    "@suite/domain": "workspace:*",
    "@suite/persistence": "workspace:*"
  },
  "devDependencies": {
    "@suite/test-support": "workspace:*",
    "tsx": "4.23.8"
  }
}
