{
  "name": "Tadooer",
  "short_name": "Tadooer",
  "description": "Private, self-hosted task and calendar planning",
  "start_url": "/today",
  "display": "standalone",
  "background_color": "#1e1e2e",
  "theme_color": "#11111b",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
