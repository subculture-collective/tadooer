{
  "name": "@suite/quick-add",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "suite-quick-add": "dist/main.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/main.ts --bundle --platform=node --format=esm --out-extension:.js=.mjs --outfile=dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@suite/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.8"
  }
}
