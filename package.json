{
  "name": "productivity-suite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @suite/web build && pnpm --filter @suite/server build && pnpm --filter @suite/mcp-stdio build && pnpm --filter @suite/quick-add build",
    "dev": "pnpm --parallel --filter @suite/web --filter @suite/server dev",
    "format": "prettier --write apps packages *.json *.js *.yaml",
    "format:check": "prettier --check apps packages *.json *.js *.yaml",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e:phase1": "node deploy/phase1-browser.mjs",
    "test:phase4": "vitest run apps/server/src/phase4.test.ts apps/mcp-stdio/src apps/quick-add/src",
    "test:phase5": "vitest run apps/server/src/phase5.test.ts apps/mcp-stdio/src",
    "test:phase6": "vitest run packages/domain/src/choice-pool.test.ts apps/server/src/phase6.test.ts apps/mcp-stdio/src",
    "verify:phase1": "./deploy/verify-phase1-compose.sh",
    "verify:phase2": "./deploy/verify-phase2-compose.sh",
    "verify:phase4": "./deploy/verify-phase4.sh",
    "verify:phase5": "./deploy/verify-phase5.sh",
    "verify:phase6": "./deploy/verify-phase6.sh",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.13",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
