# Loopback development ports
SUITE_PORT=18080
BAIKAL_PORT=18086

# The bundled default is the only browser-visible connector option. A server
# administrator may set another credentialless HTTP(S) CalDAV service root.
BAIKAL_ENDPOINT=http://baikal/dav.php/

# Keep false for direct local HTTP. Set true when the public route is HTTPS.
SUITE_SECURE_COOKIES=false

# Hosted MCP OAuth remains disabled by default. Production enablement requires
# an HTTPS public origin, exact protected-resource URI, and a mode-0600 file of
# deployment-owned public clients. Never put issued tokens in this file.
SUITE_HOSTED_OAUTH_ENABLED=false
# SUITE_HOSTED_OAUTH_CLIENT_CONFIG_PATH=/data/hosted-oauth-clients.json
# SUITE_HOSTED_OAUTH_RESOURCE=https://tadooer.example/mcp
